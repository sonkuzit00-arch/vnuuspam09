# PostgreSQL (на Vercel — Storage → Neon/Postgres, переменная подставится сама)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dgd"
NEXTAUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# Пароль для демо-пользователей при первом npm run db:seed (не обязательно —
# по умолчанию demo1234). Смените перед реальным использованием.
SEED_PASSWORD="replace-with-a-strong-password"
# true — при сиде добавить 7 демо-обращений (по умолчанию только пользователи)
SEED_DEMO_APPEALS="false"

# Общий логин/пароль на весь сайт (HTTP Basic Auth). Пусто — без защиты.
SITE_LOGIN=""
SITE_PASSWORD=""

# Публичный адрес сайта для ссылок в уведомлениях (на Vercel можно не задавать)
APP_URL=""

# Файлы к обращениям: на Vercel — Storage → Blob (private), токен подставится сам.
# Без него файлы хранятся в базе (до 10 МБ).
BLOB_READ_WRITE_TOKEN=""

# Уведомления на почту (SMTP, напр. smtp.yandex.ru:465)
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""
# Импорт писем в обращения (IMAP). Mail.ru: imap.mail.ru:993 + пароль для внешних приложений
IMAP_HOST=""
IMAP_PORT="993"
IMAP_USER=""
IMAP_PASSWORD=""
IMAP_FOLDER="INBOX"
# Кто согласовывает письма из почты (по умолчанию sofia@dgd.local — Кузнецова)
MAIL_IMPORT_RESPONSIBLE_EMAIL=""

# Общий ящик, куда приходит копия каждого нового обращения и отчёты кнопкой «На почту»
APPEALS_EMAIL_TO=""

# Уведомления в Telegram: бот от @BotFather
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME=""   # без @
TELEGRAM_WEBHOOK_SECRET="" # любая случайная строка

# Ежедневные напоминания о сроках (Vercel Cron передаёт его сам)
CRON_SECRET=""
