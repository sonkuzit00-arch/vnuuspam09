// Схема данных сервиса учёта обращений граждан ДГД.
// Перечисления валидируются на уровне приложения (src/lib/constants.ts)
// и хранятся как String.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("GD") // ADMIN | KAU | GD | GR | OP | BTL_BF | APPROVER | PRESS | VIEWER
  isActive     Boolean  @default(true) // заблокированный пользователь не может войти
  createdAt    DateTime @default(now())

  // --- Уведомления (каждый настраивает сам в профиле) ---
  notifyEmail      String? // адрес для уведомлений; пусто — на email учётной записи
  notifyByEmail    Boolean @default(false)
  notifyByTelegram Boolean @default(false)
  telegramChatId   String?
  telegramLinkCode String? @unique // одноразовый код для привязки через /start

  appeals       AppealResponsible[]
  events        AppealEvent[]
  tasksAssigned AppealTask[]        @relation("TasksAssigned")
  tasksReceived AppealTask[]        @relation("TasksReceived")
  attachments   AppealAttachment[]
  govContacts   GovContact[]        @relation("GovContactsCreated")
  giftItems     GiftItem[]          @relation("GiftItemsCreated")
  giftIssues    GiftIssue[]         @relation("GiftIssuesCreated")

  @@map("users")
}

model Appeal {
  id String @id @default(cuid())

  // --- Поступление / маршрутизация ---
  sourceChannel      String
  subject            String? // тема письма
  receivedAtDgd      DateTime?
  receivedAtKau      DateTime?
  registrationNumber String? // номер входящего в САДД
  sourceMessageId    String?   @unique // Message-ID письма, если обращение импортировано из почты
  importStatus       String? // PENDING — письмо из почты ждёт согласования проверяющим; null — обычное обращение
  forwardedToOp      Boolean   @default(false)
  forwardedToOpAt    DateTime?

  // --- Заявитель ---
  lastName       String
  firstName      String?
  middleName     String?
  birthDate      DateTime?
  position       String?
  address        String?
  district       String?
  email          String?
  phone          String?
  socialHandle   String?
  isCollective   Boolean   @default(false)
  signatoryCount Int?

  // --- Суть обращения ---
  goal           String
  description    String?
  category       String
  targetAudience String?

  // --- Решение ---
  concept              String?
  actionPlan           String?
  resolutionPath       String? // формат ответа/маршрут, назначает КАУ при триаже
  routingTarget        String? // кому конкретно (депутат/комитет), если resolutionPath — перенаправление
  controlDate          DateTime?
  dzSentAt             DateTime?
  replySentAt          DateTime?
  replyNumberToCitizen String? // номер ответа гражданину
  result               String?
  resolvedAt           DateTime?
  deadlineRemindedAt   DateTime? // когда отправлено напоминание о контрольном сроке

  // --- Ответственность по регламенту ---
  gratitudeSent     Boolean   @default(false)
  gratitudeSentAt   DateTime?
  mediaCoverageSent Boolean   @default(false)
  mediaCoverageAt   DateTime?

  stage     String   @default("IN_PROGRESS") // IN_PROGRESS | CANCELLED | REFUSED | APPLICANT_DECLINED | RESOLVED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  responsible     AppealResponsible[]
  events          AppealEvent[]
  tasks           AppealTask[]
  outgoingNumbers AppealOutgoingNumber[]
  attachments     AppealAttachment[]

  @@map("appeals")
}

// Явная связная таблица (а не просто FK), чтобы в будущем можно было
// передавать обращение другому ответственному, сохраняя историю.
model AppealResponsible {
  id         String   @id @default(cuid())
  appeal     Appeal   @relation(fields: [appealId], references: [id], onDelete: Cascade)
  appealId   String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  isCurrent  Boolean  @default(true)
  assignedAt DateTime @default(now())

  @@index([appealId])
  @@index([userId])
  @@map("appeal_responsibles")
}

// Полная история взаимодействия по обращению (требование регламента).
model AppealEvent {
  id        String   @id @default(cuid())
  appeal    Appeal   @relation(fields: [appealId], references: [id], onDelete: Cascade)
  appealId  String
  author    User?    @relation(fields: [authorId], references: [id])
  authorId  String?
  type      String // STAGE_CHANGE | NOTE | DZ_SENT | REPLY_SENT | APPLICANT_INFORMED | GRATITUDE | MEDIA | CREATED | STEP
  message   String
  createdAt DateTime @default(now())

  // --- Этап процесса, отмеченный за участника (type = STEP) ---
  // Нужен, когда кто-то работает вне приложения (напр. согласовал по почте):
  // любой сотрудник фиксирует, что произошло, кем и каким способом.
  stepType   String? // Поступило | Передано | Согласовано | …
  actorName  String? // кто (сотрудник или внешний участник)
  targetName String? // кому / от кого
  channel    String? // в приложении | по почте | по телефону | лично | через САДД
  occurredAt DateTime? // когда это произошло на самом деле
  stepNote   String? // комментарий к этапу
  editedAt   DateTime?

  @@index([appealId])
  @@map("appeal_events")
}

// Поручение по обращению: кто кому и что поручил (цепочка делегирования,
// например КАУ → GR «проработать стратегию» → GD «направить запрос и
// зарегистрировать в САДД»). Не меняет текущего ответственного за
// обращение — это отдельная, более гранулярная задача внутри него.
model AppealTask {
  id             String    @id @default(cuid())
  appeal         Appeal    @relation(fields: [appealId], references: [id], onDelete: Cascade)
  appealId       String
  assignedBy     User      @relation("TasksAssigned", fields: [assignedById], references: [id])
  assignedById   String
  assignee       User      @relation("TasksReceived", fields: [assigneeId], references: [id])
  assigneeId     String
  description    String
  status         String    @default("PENDING") // PENDING | IN_PROGRESS | DONE
  dueDate        DateTime? // срок исполнения поручения
  remindedAt     DateTime? // когда отправлено напоминание о сроке
  createdAt      DateTime  @default(now())
  completedAt    DateTime?
  completionNote String? // напр. «согласовано по почте; отметил(а) Кузнецова»

  @@index([appealId])
  @@index([assigneeId])
  @@map("appeal_tasks")
}

// Исходящий документ по обращению (перенаправление, депутатский запрос —
// их может быть несколько на одно обращение) вместе с результатом ответа
// органа власти: когда пришёл, краткая суть, оказано содействие или нет.
model AppealOutgoingNumber {
  id       String  @id @default(cuid())
  appeal   Appeal  @relation(fields: [appealId], references: [id], onDelete: Cascade)
  appealId String
  number   String
  label    String? // куда направлено / что за документ

  responseReceivedAt DateTime?
  responseSummary    String? // краткая суть ответа органа власти
  assistanceProvided Boolean? // оказано содействие: true/false, null — ответа ещё нет

  createdAt DateTime @default(now())

  @@index([appealId])
  @@map("appeal_outgoing_numbers")
}

// Файл, приложенный к обращению (скан письма, ответ органа власти и т.п.).
// На Vercel содержимое лежит в приватном Vercel Blob (blobPathname), без
// BLOB_READ_WRITE_TOKEN — прямо в базе (data), для внутреннего сервера.
model AppealAttachment {
  id           String   @id @default(cuid())
  appeal       Appeal   @relation(fields: [appealId], references: [id], onDelete: Cascade)
  appealId     String
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  uploadedById String?
  fileName     String
  contentType  String
  size         Int
  blobPathname String?
  data         Bytes?
  createdAt    DateTime @default(now())

  @@index([appealId])
  @@map("appeal_attachments")
}

// Книжка контактов ОГВ: сотрудники органов власти, с которыми работаем по
// обращениям. Общая для всех пользователей.
model GovContact {
  id           String   @id @default(cuid())
  organization String // орган власти
  department   String? // управление / отдел
  fullName     String
  position     String?
  phone        String?
  mobilePhone  String?
  email        String?
  note         String?
  createdBy    User?    @relation("GovContactsCreated", fields: [createdById], references: [id], onDelete: SetNull)
  createdById  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([organization])
  @@map("gov_contacts")
}

// Реестр подарков в наличии (алкоголь, сертификаты, сувениры).
// quantity — сколько осталось; выдача после согласования ЧСВ уменьшает
// остаток и записывается в GiftIssue. Позиция с нулевым остатком
// пропадает из «В наличии», но её история выдач сохраняется.
model GiftItem {
  id          String      @id @default(cuid())
  category    String // Алкоголь | Сертификат | Сувенир | Другое
  name        String
  description String?
  nominal     Int? // номинал сертификата / цена, ₽
  quantity    Int         @default(1)
  note        String?
  createdBy   User?       @relation("GiftItemsCreated", fields: [createdById], references: [id], onDelete: SetNull)
  createdById String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  issues      GiftIssue[]

  @@map("gift_items")
}

// Выдача подарка, согласованная ЧСВ.
model GiftIssue {
  id         String   @id @default(cuid())
  item       GiftItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemId     String
  quantity   Int      @default(1)
  recipient  String // кому
  reason     String? // повод
  approvedAt DateTime // дата согласования ЧСВ
  issuedBy   User?    @relation("GiftIssuesCreated", fields: [issuedById], references: [id], onDelete: SetNull)
  issuedById String?
  createdAt  DateTime @default(now())

  @@index([itemId])
  @@map("gift_issues")
}
